{
	 frankenphp
}

:{$PORT:80} {
	route /api/* {
		@php path_regexp php ^/api/.*\.php$
		handle @php {
			uri strip_prefix /api
			root * /app/api
			php_server
		}
		handle {
			rewrite * /router.php?route={path}&{query}
			root * /app/api
			php_server
		}
	}

	route {
		root * /app/public
		encode zstd gzip
		php_server
	}
}

