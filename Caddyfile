{
	 frankenphp
}

:{$PORT:80} {
	# Strip /api once so direct PHP aliases resolve from /app/api.
	handle_path /api/* {
		root * /app/api

		@php path *.php
		handle @php {
			php_server
		}

		# Clean API paths go through the central router. Keep incoming filters,
		# status values, and other query parameters when rewriting the URI.
		handle {
			rewrite * /router.php?route={path}&{query}
			php_server
		}
	}

	handle {
		root * /app/public
		encode zstd gzip
		php_server
	}
}

